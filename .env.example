# INNOVORTEX Environment Configuration Template
# DO NOT ADD SENSITIVE API KEYS OR SECRETS TO THIS FILE.
# Copy to `.env.local` for local development.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Contact & Demo Submission Webhooks (Optional)
CONTACT_FORM_WEBHOOK_URL=
DEMO_REQUEST_WEBHOOK_URL=

# SafeEdge admin authentication and realtime API
ADMIN_EMAIL=admin@safeedge.example
# Generate with: npm run generate:admin-password -- "choose-a-strong-password"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=
# Comma-separated browser origins permitted to connect via Socket.IO.
CORS_ORIGIN=http://localhost:3000
